{
    "name": "Development Container",
    "privileged": true,
    "remoteUser": "user",
    "dockerComposeFile": [
        "./docker-compose.yml",
        "./docker-compose.override.yml"
    ],
    "service": "rl-dev",
    "workspaceFolder": "/reinforcement-learning-demos",
    "overrideCommand": false,
    "postCreateCommand": "pip install -r requirements.txt",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash"
                    }
                },
                "python.analysis.extraPaths": [
                    "${containerEnv:CONDA_PREFIX}/lib/python.11/site-packages"
                ],
                // When the container provides a conda env, point VS Code's default interpreter there
                "python.defaultInterpreterPath": "${containerEnv:CONDA_PREFIX}/bin/python"
            }
        }
    }
}